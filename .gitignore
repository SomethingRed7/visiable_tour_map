# MCP 运行日志(不在仓库维护范围)
logs/

# 本地计划/工作文档
.hermes/

# 照片原图暂存(压缩后才会入库;照片实际存 R2,不入仓库)
photos/

# 本机 Agent 记忆/工作文档(含个人行程信息,勿进公开仓库)
.workbuddy/

# Node / wrangler
node_modules/
.wrangler/

# 本地密钥/环境变量(含 SESSION_SECRET 等;生产环境同值以 Cloudflare Secrets 存放)
.dev.vars

# macOS
.DS_Store

# app 自更新用的安装包(每次发版由 publish-app.sh 生成并部署,不进仓库)
public/download/

# ---------- Android 壳工程 ----------
# android-app/ 已独立为 git submodule(私有仓库 SomethingRed7/gugugaga-android),
# 它自己的 .gitignore 负责 node_modules / 构建产物 / 签名材料 / local.properties。
# 这里不需要也不应该再管它。

# 兜底:公开仓库里绝不出现签名材料(即使以后不小心在根目录生成)
*.jks
*.keystore
